rules_version = '2';

// Timavörður — Firestore security rules.
//
// All application data access happens server-side through Next.js API routes
// using the Firebase Admin SDK, which BYPASSES these rules entirely. No client
// code reads or writes Firestore directly (the client only holds an auth token
// and calls /api/*). Therefore the correct and safest posture is to deny ALL
// direct client access: an attacker with a leaked web API key still cannot read
// staff records, punch records, wages, or company data straight from Firestore.
//
// If a future feature needs direct client reads, add a narrowly-scoped allow
// rule here (e.g. a staff member reading only their own document) rather than
// loosening this default.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
